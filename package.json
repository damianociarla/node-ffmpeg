{
  "name": "ffmpeg",
  "version": "1.1.3",
  "description": "A modern, typed Node.js API for processing media with FFmpeg",
  "keywords": [
    "ffmpeg",
    "ffprobe",
    "video",
    "audio",
    "transcoding",
    "typescript"
  ],
  "author": {
    "name": "Damiano Ciarla",
    "email": "damiano.ciarla@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damianociarla/node-ffmpeg.git"
  },
  "bugs": {
    "url": "https://github.com/damianociarla/node-ffmpeg/issues"
  },
  "homepage": "https://damianociarla.github.io/node-ffmpeg/",
  "type": "module",
  "main": "./index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.cjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "RELEASING.md",
    "AUDIT.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "node test/run-integration.mjs",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm test && npm run build && npm run docs:build && npm run test:visual && npm run pack:check",
    "pack:check": "node test/cjs-smoke.cjs && npm pack --dry-run && node test/package-types.mjs",
    "test:visual": "playwright test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitepress": "1.6.4",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "vite": "6.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false
  }
}
